// Tang Nano 9K pin constraints - Step 7 (UART)

// 27 MHz oscillator
IO_LOC  "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Buttons (active low): S1 = reset, S2 = read by the program
IO_LOC  "btn1" 4;
IO_PORT "btn1" IO_TYPE=LVCMOS18 PULL_MODE=UP;
IO_LOC  "btn2" 3;
IO_PORT "btn2" IO_TYPE=LVCMOS18 PULL_MODE=UP;

// 6 onboard LEDs (active low), bank 3 is 1.8 V
IO_LOC  "led[0]" 10;
IO_PORT "led[0]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_LOC  "led[1]" 11;
IO_PORT "led[1]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_LOC  "led[2]" 13;
IO_PORT "led[2]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_LOC  "led[3]" 14;
IO_PORT "led[3]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_LOC  "led[4]" 15;
IO_PORT "led[4]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_LOC  "led[5]" 16;
IO_PORT "led[5]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;

// Serial port to the board's USB chip (BL702): FPGA transmits on 17, receives on 18
IO_LOC  "uart_tx" 17;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "uart_rx" 18;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// HDMI connector, differential pairs "P,N"
//   clock = 69/68, data0 (blue) = 71/70, data1 (green) = 73/72, data2 (red) = 75/74
// The IO_TYPE goes on the _p port only; the _n pins must also be listed or
// nextpnr reports them as unconstrained.
IO_LOC  "tmds_clk_p" 69,68;
IO_PORT "tmds_clk_p" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_LOC  "tmds_d_p[0]" 71,70;
IO_PORT "tmds_d_p[0]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_LOC  "tmds_d_p[1]" 73,72;
IO_PORT "tmds_d_p[1]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_LOC  "tmds_d_p[2]" 75,74;
IO_PORT "tmds_d_p[2]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;

IO_LOC  "tmds_clk_n" 68;
IO_LOC  "tmds_d_n[0]" 70;
IO_LOC  "tmds_d_n[1]" 72;
IO_LOC  "tmds_d_n[2]" 74;
